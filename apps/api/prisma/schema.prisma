// EduSuite database schema (plan §06 Data model, plus DN-013, DN-014, DN-015, DN-026).
//
// Rules:
// - Every business table carries institute_id, and every query is scoped by it.
// - Money uses Decimal, never float.
// - Fee receipts are never deleted, only cancelled (status + reason).
// - Documents are soft-deleted (deleted_at).
// - Never edit a migration that has been applied; add a new one.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum UserRole {
  superadmin
  branch_admin
  teacher
  typist
  counselor
}

enum UserStatus {
  active
  blocked
}

enum DocumentType {
  ppt
  mcq_set
  paper
  dpp
  lesson
  book
  doubt
  youtube
  notice
  poster
}

enum AiJobType {
  ppt_outline
  mcq_extract
  paper_generate
  dpp_generate
  lesson_plan
  book_chapter
  doubt_solve
  youtube_meta
  notice_draft
  poster_copy
  pptx_build
}

enum AiJobStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

enum StudentStatus {
  active
  left
}

enum PaymentMode {
  cash
  upi
  card
  bank_transfer
  cheque
}

enum ReceiptStatus {
  issued
  cancelled
}

// ---------- Tenancy ----------

model Institute {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String
  /// Short code used in receipt numbers, e.g. "IND" (DN-013).
  code                String   @unique
  branding            Json     @default("{}")
  aiMonthlyTokenQuota Int      @default(0) @map("ai_monthly_token_quota")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  branches    Branch[]
  users       AppUser[]
  documents   Document[]
  files       File[]
  aiJobs      AiJob[]
  aiUsage     AiUsage[]
  questions   Question[]
  students    Student[]
  feeReceipts FeeReceipt[]
  auditLogs   AuditLog[]

  @@map("institutes")
}

model Branch {
  id          String   @id @default(uuid()) @db.Uuid
  instituteId String   @map("institute_id") @db.Uuid
  name        String
  /// Short code used in receipt numbers, e.g. "BKN" (DN-013).
  code        String
  city        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  institute       Institute        @relation(fields: [instituteId], references: [id])
  homeUsers       AppUser[]        @relation("HomeBranch")
  userBranches    UserBranch[]
  documents       Document[]
  students        Student[]
  feeReceipts     FeeReceipt[]
  receiptCounters ReceiptCounter[]
  sessions        Session[]

  @@unique([instituteId, code])
  @@map("branches")
}

// ---------- People and sessions ----------

model AppUser {
  id               String     @id @default(uuid()) @db.Uuid
  instituteId      String     @map("institute_id") @db.Uuid
  /// The branch the user normally works at (DN-015).
  branchId         String     @map("branch_id") @db.Uuid
  /// Login identifiers are unique across the whole system, because the login form has no institute field (DN-026).
  employeeCode     String     @unique @map("employee_code")
  email            String     @unique
  phone            String?    @unique
  fullName         String     @map("full_name")
  displayName      String     @map("display_name")
  passwordHash     String     @map("password_hash")
  role             UserRole
  status           UserStatus @default(active)
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until") @db.Timestamptz
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  institute         Institute    @relation(fields: [instituteId], references: [id])
  branch            Branch       @relation("HomeBranch", fields: [branchId], references: [id])
  /// Extra branches the user may pick at login (DN-015).
  branches          UserBranch[]
  sessions          Session[]
  documents         Document[]
  files             File[]
  aiJobs            AiJob[]
  questions         Question[]
  receiptsIssued    FeeReceipt[] @relation("ReceiptIssuedBy")
  receiptsCancelled FeeReceipt[] @relation("ReceiptCancelledBy")
  auditLogs         AuditLog[]

  @@index([instituteId, role])
  @@map("app_users")
}

model UserBranch {
  userId   String @map("user_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid

  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branches")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// Hash of the refresh token; the token itself is never stored.
  refreshHash  String    @unique @map("refresh_hash")
  deviceId     String    @map("device_id")
  /// The branch chosen at login, checked against the user's allowed branches.
  branchId     String    @map("branch_id") @db.Uuid
  /// 23:59 IST on the day of login (plan §05).
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  /// Set when this token is rotated; reuse of a replaced token revokes every session (plan §09).
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt   DateTime  @default(now()) @map("last_used_at") @db.Timestamptz

  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch  @relation(fields: [branchId], references: [id])

  @@index([userId, expiresAt])
  @@map("sessions")
}

// ---------- Documents, files, AI ----------

model Document {
  id            String       @id @default(uuid()) @db.Uuid
  instituteId   String       @map("institute_id") @db.Uuid
  branchId      String       @map("branch_id") @db.Uuid
  createdById   String       @map("created_by") @db.Uuid
  type          DocumentType
  title         String
  /// Checked by the per-type zod schema in packages/shared (ADR-3).
  content       Json
  schemaVersion Int          @default(1) @map("schema_version")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  /// Soft delete (DN-014).
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz

  institute Institute @relation(fields: [instituteId], references: [id])
  branch    Branch    @relation(fields: [branchId], references: [id])
  createdBy AppUser   @relation(fields: [createdById], references: [id])
  files     File[]
  aiJobs    AiJob[]

  /// Cursor pagination is ordered by (updated_at, id) (plan §07).
  @@index([instituteId, type, updatedAt, id])
  @@index([instituteId, createdById, updatedAt, id])
  @@map("documents")
}

model File {
  id           String   @id @default(uuid()) @db.Uuid
  instituteId  String   @map("institute_id") @db.Uuid
  uploadedById String   @map("uploaded_by") @db.Uuid
  documentId   String?  @map("document_id") @db.Uuid
  /// Random key in the bucket; never derived from the file name (AGENT_README §8).
  bucketKey    String   @unique @map("bucket_key")
  mime         String
  bytes        Int
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  institute  Institute  @relation(fields: [instituteId], references: [id])
  uploadedBy AppUser    @relation(fields: [uploadedById], references: [id])
  document   Document?  @relation(fields: [documentId], references: [id])
  questions  Question[]
  students   Student[]

  @@index([instituteId, createdAt])
  @@map("files")
}

model AiJob {
  id             String      @id @default(uuid()) @db.Uuid
  instituteId    String      @map("institute_id") @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  type           AiJobType
  status         AiJobStatus @default(queued)
  input          Json
  error          String?
  /// The document this job produced, if any.
  documentId     String?     @map("document_id") @db.Uuid
  idempotencyKey String      @map("idempotency_key")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  startedAt      DateTime?   @map("started_at") @db.Timestamptz
  finishedAt     DateTime?   @map("finished_at") @db.Timestamptz

  institute Institute @relation(fields: [instituteId], references: [id])
  user      AppUser   @relation(fields: [userId], references: [id])
  document  Document? @relation(fields: [documentId], references: [id])
  usage     AiUsage[]

  @@unique([instituteId, idempotencyKey])
  @@index([instituteId, createdAt])
  @@map("ai_jobs")
}

model AiUsage {
  id               String   @id @default(uuid()) @db.Uuid
  instituteId      String   @map("institute_id") @db.Uuid
  aiJobId          String   @map("ai_job_id") @db.Uuid
  model            String
  inputTokens      Int      @map("input_tokens")
  outputTokens     Int      @map("output_tokens")
  cacheReadTokens  Int      @default(0) @map("cache_read_tokens")
  cacheWriteTokens Int      @default(0) @map("cache_write_tokens")
  costUsd          Decimal  @map("cost_usd") @db.Decimal(12, 6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  institute Institute @relation(fields: [instituteId], references: [id])
  aiJob     AiJob     @relation(fields: [aiJobId], references: [id])

  /// Monthly quota checks sum usage by institute and month.
  @@index([instituteId, createdAt])
  @@map("ai_usage")
}

model Question {
  id           String   @id @default(uuid()) @db.Uuid
  instituteId  String   @map("institute_id") @db.Uuid
  createdById  String   @map("created_by") @db.Uuid
  subject      String
  topic        String?
  bodyHi       String   @map("body_hi")
  bodyEn       String?  @map("body_en")
  /// { A, B, C, D }, checked by a zod schema.
  options      Json
  answer       String
  trick        String?
  sourceFileId String?  @map("source_file_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  institute  Institute @relation(fields: [instituteId], references: [id])
  createdBy  AppUser   @relation(fields: [createdById], references: [id])
  sourceFile File?     @relation(fields: [sourceFileId], references: [id])

  @@index([instituteId, subject, topic])
  @@map("questions")
}

// ---------- Students and fees ----------

model Student {
  id           String        @id @default(uuid()) @db.Uuid
  instituteId  String        @map("institute_id") @db.Uuid
  branchId     String        @map("branch_id") @db.Uuid
  rollNo       String        @map("roll_no")
  fullName     String        @map("full_name")
  guardianName String?       @map("guardian_name")
  phone        String?
  course       String
  batch        String?
  photoFileId  String?       @map("photo_file_id") @db.Uuid
  totalFee     Decimal       @map("total_fee") @db.Decimal(12, 2)
  status       StudentStatus @default(active)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  institute   Institute    @relation(fields: [instituteId], references: [id])
  branch      Branch       @relation(fields: [branchId], references: [id])
  photo       File?        @relation(fields: [photoFileId], references: [id])
  feeReceipts FeeReceipt[]

  @@unique([instituteId, rollNo])
  @@index([instituteId, branchId, updatedAt, id])
  @@map("students")
}

/// One row per branch per financial year, read with SELECT … FOR UPDATE
/// inside the transaction that inserts the receipt (plan §06, DN-013).
model ReceiptCounter {
  branchId      String @map("branch_id") @db.Uuid
  /// e.g. "2026-27"; resets on 1 April.
  financialYear String @map("financial_year")
  lastSeq       Int    @default(0) @map("last_seq")

  branch Branch @relation(fields: [branchId], references: [id])

  @@id([branchId, financialYear])
  @@map("receipt_counters")
}

model FeeReceipt {
  id             String        @id @default(uuid()) @db.Uuid
  instituteId    String        @map("institute_id") @db.Uuid
  branchId       String        @map("branch_id") @db.Uuid
  studentId      String        @map("student_id") @db.Uuid
  /// e.g. IND-BKN/2026-27/000431
  receiptNo      String        @unique @map("receipt_no")
  amount         Decimal       @db.Decimal(12, 2)
  mode           PaymentMode
  paidOn         DateTime      @map("paid_on") @db.Date
  issuedById     String        @map("issued_by") @db.Uuid
  status         ReceiptStatus @default(issued)
  cancelReason   String?       @map("cancel_reason")
  cancelledById  String?       @map("cancelled_by") @db.Uuid
  cancelledAt    DateTime?     @map("cancelled_at") @db.Timestamptz
  idempotencyKey String        @map("idempotency_key")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  institute   Institute @relation(fields: [instituteId], references: [id])
  branch      Branch    @relation(fields: [branchId], references: [id])
  student     Student   @relation(fields: [studentId], references: [id])
  issuedBy    AppUser   @relation("ReceiptIssuedBy", fields: [issuedById], references: [id])
  cancelledBy AppUser?  @relation("ReceiptCancelledBy", fields: [cancelledById], references: [id])

  @@unique([instituteId, idempotencyKey])
  @@index([instituteId, studentId])
  @@map("fee_receipts")
}

// ---------- Audit ----------

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  /// Null only for events before an institute is known (e.g. a failed login for an unknown ID).
  instituteId String?  @map("institute_id") @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  /// e.g. "auth.login", "user.block", "receipt.cancel", "document.delete", "document.export"
  action      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  /// Never holds passwords, tokens or full student records (AGENT_README §8).
  meta        Json     @default("{}")
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  institute Institute? @relation(fields: [instituteId], references: [id])
  actor     AppUser?   @relation(fields: [actorId], references: [id])

  @@index([instituteId, createdAt])
  @@map("audit_logs")
}
