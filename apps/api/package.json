{
  "name": "@edusuite/api",
  "version": "0.1.0",
  "private": true,
  "description": "EduSuite API (NestJS on Fastify) and AI worker",
  "type": "commonjs",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:validate": "prisma validate",
    "prebuild": "npm run build -w @edusuite/shared && prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "dev": "npm run build && node --env-file-if-exists=../../infra/.env.local dist/src/main.js",
    "pretypecheck": "npm run build -w @edusuite/shared && prisma generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build -w @edusuite/shared && prisma generate",
    "test": "tsc -p tsconfig.json && node --test \"dist/test/**/*.test.js\"",
    "lint": "oxlint -c ../../.oxlintrc.json src test"
  },
  "dependencies": {
    "@edusuite/shared": "*",
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-fastify": "^11.2.11",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.11",
    "prisma": "^7.10.1"
  }
}
