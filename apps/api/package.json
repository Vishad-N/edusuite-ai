{
  "name": "@edusuite/api",
  "version": "0.1.0",
  "private": true,
  "description": "EduSuite API (NestJS on Fastify) and AI worker",
  "type": "commonjs",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:validate": "prisma validate",
    "prebuild": "npm run build -w @edusuite/shared && prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "dev": "npm run build && node --env-file-if-exists=../../infra/.env.local dist/src/main.js",
    "pretypecheck": "npm run build -w @edusuite/shared && prisma generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build -w @edusuite/shared && prisma generate",
    "test": "tsc -p tsconfig.json && node --env-file-if-exists=../../infra/.env.local --test --test-concurrency=1 \"dist/test/**/*.test.js\"",
    "lint": "oxlint -c ../../.oxlintrc.json src test",
    "load": "node scripts/load-test.mjs",
    "db:seed": "npm run build && node --env-file-if-exists=../../infra/.env.local dist/src/scripts/seed.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@edusuite/shared": "*",
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-fastify": "^11.2.11",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.8.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/node": "^11.17.0",
    "bullmq": "^6.7.8",
    "ioredis": "^6.0.0",
    "jose": "^6.2.18",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.11",
    "autocannon": "^8.0.0",
    "prisma": "^7.10.1"
  }
}
