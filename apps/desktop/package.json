{
  "name": "@edusuite/desktop",
  "private": true,
  "version": "1.0.0",
  "description": "All-in-One Desktop Studio for Schools & Coaching Institutes",
  "author": "EduSuite",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint -c ../../.oxlintrc.json src electron",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "dist": "vite build && electron-builder",
    "dist:portable": "vite build && electron-builder --win portable",
    "dist:nsis": "vite build && electron-builder --win nsis",
    "dist:mac": "vite build && electron-builder --mac dmg zip",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --conditions=source --test \".test-dist/**/*.test.js\" \"src/**/*.test.mjs\" \"electron/*.test.cjs\""
  },
  "build": {
    "appId": "com.edusuite.desktop",
    "productName": "EduSuite AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "!electron/*.test.cjs"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "EduSuite-AI-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "identity": null
    },
    "dmg": {
      "title": "EduSuite AI Installer",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EduSuite AI",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.example.invalid/desktop/"
      }
    ]
  },
  "dependencies": {
    "@sentry/electron": "^8.4.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.2",
    "canvas-confetti": "^1.9.4",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.75.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.3.4",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.90.0",
    "vite": "^8.3.6"
  }
}
