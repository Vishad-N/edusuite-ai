# Local testing: run `npm run stack:env` to create infra/.env.local from this file
# with fresh random secrets (never commit the copy).
# On the VPS, the real values live in infra/.env (chmod 600).
# Placeholder values in angle brackets are filled in by `npm run stack:env`.

NODE_ENV=development
LOG_LEVEL=info

POSTGRES_USER=edusuite
POSTGRES_PASSWORD=<generate>
POSTGRES_DB=edusuite

# Used by the API when it runs outside Docker (npm run dev -w @edusuite/api).
DATABASE_URL=postgres://edusuite:<POSTGRES_PASSWORD>@127.0.0.1:5432/edusuite
REDIS_URL=redis://127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:3900
S3_PUBLIC_ENDPOINT=http://localhost:3900

# Signs the 15-minute access tokens. Changing it signs everyone out.
JWT_SECRET=<generate>

# Garage storage (DN-027).
GARAGE_RPC_SECRET=<generate>
GARAGE_ADMIN_TOKEN=<generate>
S3_BUCKET=edusuite-files
# Garage key format: "GK" + 24 hex characters; secret: 64 hex characters.
S3_ACCESS_KEY_ID=<generate>
S3_SECRET_ACCESS_KEY=<generate>

# Production only: the public API host name served by Caddy.
API_DOMAIN=api.example.com
# Production only: host name for file downloads and uploads (Caddy proxies it to Garage).
FILES_DOMAIN=files.example.com
# Production only: update feed and download page (Phase 6, DN-062).
UPDATES_DOMAIN=updates.example.com

# Phase 4: AI (DN-054). AI_MODE: fixture (sample answers, no Claude calls; refused in production),
# record (calls Claude and saves answers as fixtures) or live. Only the worker uses the key.
AI_MODE=fixture
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Phase 6 backups (DN-063). RESTIC_PASSWORD encrypts every backup: keep a copy OFF the
# server (a password manager). Losing it makes the backups unreadable.
# Production: an S3 repository on Cloudflare R2 or Backblaze B2 plus its keys.
RESTIC_REPOSITORY=/backup-repo
RESTIC_PASSWORD=<generate>
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
AI_CONCURRENCY=2
# Optional per-job model, e.g. AI_MODEL_DECK_QUIZ=claude-sonnet-5-5 (default: AI_MODEL).
# AI jobs one signed-in session may start per minute (DN-065).
AI_RATE_LIMIT=20
# API docs at https://<API_DOCS domain>/docs (DN-067). Empty: on locally, off in production.
API_DOCS=
# Error reporting to Sentry (DN-068) for the API and the AI worker. Empty: off.
# Only unexpected server errors and failed AI jobs are sent, with no request data or user details.
SENTRY_DSN=
# Defaults to NODE_ENV, e.g. set "pilot" or "production".
SENTRY_ENVIRONMENT=
